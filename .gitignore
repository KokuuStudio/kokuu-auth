# ---- KokuuSkin 定制补充 ----
# 依赖锁文件（含平台特定内容，不适合分发）
composer.lock
package-lock.json

# SQLite 变体文件
*.sqlite-shm
*.sqlite-wal
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal

# 日志与调试
