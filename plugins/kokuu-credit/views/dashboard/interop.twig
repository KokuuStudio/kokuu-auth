{#
  仪表盘 · 社区互联容器

  与积分卡并排，展示论坛互通状态与入口。
  设计目标：一屏说清「论坛和皮肤站是不是同一个账号体系」。

  数据来自 View::share('kcDash', ...)，见 bootstrap.php 的 grid:admin.index。
#}
{% set data = kcDash %}

<div class="kcDash-col">
  <section class="kcDash-card kcDash-card--interop">
    <header class="kcDash-head">
      <span class="kcDash-eyebrow">
        <i class="fas fa-link"></i>
        社区互联
      </span>
      <span class="kcDash-pill {{ data.bound ? 'is-on' : 'is-off' }}">
        {{ data.bound ? '已互通' : '未互通' }}
      </span>
    </header>

    {# ---------- 互通说明 ---------- #}
    <p class="kcDash-lede">
      皮肤站账户与论坛账户已打通。在论坛登录会直接使用皮肤站的账号，
      论坛不保存独立密码。
    </p>

    {# ---------- 状态明细 ---------- #}
    <ul class="kcDash-facts">
      <li class="kcDash-fact">
        <span class="kcDash-fact-label">论坛地址</span>
        <a class="kcDash-fact-value" href="{{ data.forumUrl }}" target="_blank" rel="noopener">
          {{ data.forumUrl|replace({'https://': ''}) }}
          <i class="fas fa-external-link-alt"></i>
        </a>
      </li>
      <li class="kcDash-fact">
        <span class="kcDash-fact-label">当前账号</span>
        <span class="kcDash-fact-value">{{ auth_user().email }}</span>
      </li>
      <li class="kcDash-fact">
        <span class="kcDash-fact-label">互通状态</span>
        <span class="kcDash-fact-value">
          {% if data.bound %}
            已授权{% if data.lastUse %} · 最近 {{ data.lastUse }}{% endif %}
          {% else %}
            尚未通过论坛授权
          {% endif %}
        </span>
      </li>
    </ul>

    {# ---------- 加分规则 ---------- #}
    <div class="kcDash-rules">
      <div class="kcDash-rule">
        <span class="kcDash-rule-num">+{{ data.scoreThread }}</span>
        <span class="kcDash-rule-label">发起主题</span>
      </div>
      <div class="kcDash-rule">
        <span class="kcDash-rule-num">+{{ data.scoreReply }}</span>
        <span class="kcDash-rule-label">回复帖子</span>
      </div>
    </div>

    {# ---------- 入口 ---------- #}
    <a class="kcDash-cta" href="{{ data.forumUrl }}" target="_blank" rel="noopener">
      前往论坛
      <i class="fas fa-arrow-right"></i>
    </a>
  </section>
</div>
